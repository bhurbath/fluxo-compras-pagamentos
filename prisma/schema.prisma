generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Ticket 01: base user record, populated on Microsoft SSO login.
model Usuario {
  id             String   @id @default(cuid())
  nome           String
  email          String   @unique
  idEntra        String   @unique
  flagFinanceiro Boolean  @default(false)
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  // Ticket 02: which department this employee belongs to (nullable — not
  // every logged-in user has been assigned one yet).
  departamentoId String?
  departamento   Departamento? @relation("FuncionarioDepartamento", fields: [departamentoId], references: [id])

  // Inverse sides of Departamento.responsavel / Departamento.diretor — a
  // Usuario can be the level-1 or level-2 approver for several departments.
  departamentosResponsavel Departamento[] @relation("DepartamentoResponsavel")
  departamentosDiretor     Departamento[] @relation("DepartamentoDiretor")

  // Ticket 04: matrix entries where this Usuario is the designated comprador.
  matrizComprador MatrizComprador[]

  // Ticket 05: solicitações this Usuario created, vs. ones assigned to them
  // to buy (a later ticket) — distinct relations, same two models.
  solicitacoesCriadas   Solicitacao[]          @relation("SolicitacoesCriadas")
  solicitacoesCompradas Solicitacao[]          @relation("SolicitacoesCompradas")
  solicitacaoHistorico  SolicitacaoHistorico[]

  @@map("usuarios")
}

// Ticket 02: organizational structure the approval flow is built on.
// responsavelId (level-1 approver) and diretorId (level-2 approver) are
// required, not nullable — a department can't be created without both.
model Departamento {
  id            String   @id @default(cuid())
  nome          String   @unique
  responsavelId String
  responsavel   Usuario  @relation("DepartamentoResponsavel", fields: [responsavelId], references: [id])
  diretorId     String
  diretor       Usuario  @relation("DepartamentoDiretor", fields: [diretorId], references: [id])
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  funcionarios Usuario[] @relation("FuncionarioDepartamento")

  // Ticket 04: matrix entries scoped to this department.
  matrizComprador MatrizComprador[]

  // Ticket 05: solicitações made against this department.
  solicitacoes Solicitacao[]

  @@map("departamentos")
}

// Ticket 03: value bands that decide whether a solicitação needs only
// level-1 (responsável) approval or level-2 (diretor) as well. Company-wide,
// not per-department — no departamentoId here. exigeNivel2 is a boolean, not
// a level count, so the model can't express more than 2 approval levels.
model FaixaAlcada {
  id           String   @id @default(cuid())
  valorMin     Decimal  @db.Decimal(12, 2)
  valorMax     Decimal? @db.Decimal(12, 2)
  exigeNivel2  Boolean
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("faixas_alcada")
}

// Ticket 04: categorizes solicitações; seeded with 3 initial values but
// extensible via the admin screen without code changes.
model TipoCompra {
  id           String   @id @default(cuid())
  nome         String   @unique
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // Quando true, a designação de comprador (ver designarComprador em
  // workflow.ts) pula a matriz de comprador e a designação manual: o
  // comprador é sempre o próprio solicitante, já que é ele quem vai
  // executar a contratação (ex: serviços por departamento).
  compradorEhSolicitante Boolean @default(false)

  // Quando true, o formulário de solicitação muda inteiramente: só pede
  // Fornecedor, Categoria de despesa de pessoal, nº do pedido (opcional),
  // data de vencimento, dados de pagamento (opcional), informações
  // complementares, valor, Empresa e anexos — sem centro de custo/resultado,
  // conta contábil ou forma de pagamento. A aprovação é sempre dispensada
  // (ver resolverEstadoInicial em workflow.ts) e a solicitação já nasce
  // marcada semCompra, indo direto para AGUARDANDO_PAGAMENTO — são encargos,
  // benefícios, taxas etc. pagos diretamente pelo Financeiro, sem etapa de
  // compra nem aprovação.
  despesaPessoal Boolean @default(false)

  // Quando true (tipicamente Mercado Livre/cartão de crédito): ao confirmar
  // a compra (ver confirmarCompra em workflow.ts), o comprador é obrigado a
  // informar uma previsão de chegada, que vai para o solicitante. E, quando
  // a nota fiscal é enviada depois (ver processarEnvioPagamento), o aviso
  // vai só para o Financeiro — o solicitante já sabe que a compra foi feita
  // desde a confirmação, não precisa ser notificado de novo nessa etapa
  // puramente administrativa.
  exigePrevisaoChegada Boolean @default(false)

  // Quando true (tipicamente Mercado Livre): o link da compra já traz
  // fornecedor e forma de pagamento, então esses dois campos saem do
  // formulário de solicitação (ver validarCriarSolicitacao/
  // mapCamposSolicitacao em workflow.ts). Valor continua obrigatório — é
  // ele que decide a alçada de aprovação, independente do tipo de compra.
  dispensaFornecedorForma Boolean @default(false)

  // Quando definida, toda solicitação desse tipo usa sempre esta empresa
  // (ver mapCamposSolicitacao) em vez do solicitante escolher — ex.:
  // Mercado Livre é sempre comprado pela SMELL. onDelete: Restrict para não
  // silenciosamente desconfigurar isso se a empresa fixada for excluída.
  empresaFixaId String?
  empresaFixa   Empresa? @relation(fields: [empresaFixaId], references: [id], onDelete: Restrict)

  // Quando true (RDV — prestação de contas de reembolso enviada pelo
  // colaborador): já vem aprovada pelo gestor em outro sistema, então a
  // aprovação é sempre dispensada aqui também (mesmo mecanismo de
  // despesaPessoal — ver resolverEstadoInicial) e a solicitação já nasce
  // marcada semCompra, indo direto para AGUARDANDO_PAGAMENTO. O formulário
  // muda para os campos próprios de uma RDV — ver
  // validarCriarSolicitacao/mapCamposSolicitacao em workflow.ts.
  rdv Boolean @default(false)

  matrizComprador MatrizComprador[]

  // Ticket 05: solicitações of this tipo de compra.
  solicitacoes Solicitacao[]

  @@map("tipos_compra")
}

// Ticket 04: for a given (departamento, tipoCompra) pair, who buys it — the
// lookup a later ticket uses to auto-assign a comprador once a solicitação
// is approved. Not every combination needs an entry (unmatched ones fall
// back to Financeiro deciding manually), so the FK pair is unique but
// optional to populate.
model MatrizComprador {
  id             String       @id @default(cuid())
  departamentoId String
  departamento   Departamento @relation(fields: [departamentoId], references: [id])
  tipoCompraId   String
  tipoCompra     TipoCompra   @relation(fields: [tipoCompraId], references: [id])
  compradorId    String
  comprador      Usuario      @relation(fields: [compradorId], references: [id])
  criadoEm       DateTime     @default(now())
  atualizadoEm   DateTime     @updatedAt

  @@unique([departamentoId, tipoCompraId])
  @@map("matriz_comprador")
}

// Ticket 05: simple named lookups requested alongside the solicitação form
// (matching the company's existing purchase-request template) — each is
// just a name, cadastrado pelo Financeiro, same shape as TipoCompra.
model CentroCusto {
  id           String   @id @default(cuid())
  nome         String   @unique
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  solicitacoes Solicitacao[]

  @@map("centros_custo")
}

model CentroResultado {
  id           String   @id @default(cuid())
  nome         String   @unique
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  solicitacoes Solicitacao[]

  @@map("centros_resultado")
}

model ContaContabil {
  id           String   @id @default(cuid())
  nome         String   @unique
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  solicitacoes Solicitacao[]

  @@map("contas_contabeis")
}

model Empresa {
  id           String   @id @default(cuid())
  nome         String   @unique
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  solicitacoes Solicitacao[]
  // Inverso de TipoCompra.empresaFixaId.
  tiposCompraComEmpresaFixa TipoCompra[]

  @@map("empresas")
}

// Categoria da despesa quando TipoCompra.despesaPessoal é true (Salários,
// Adiantamentos, Férias, Rescisões, Benefícios, Taxas Assistenciais, Taxas
// Sindicais, Encargos, Exames, Entidades de apoio, Planos de Saúde — ver
// seed) — cadastro simples igual a CentroCusto/CentroResultado/etc.,
// pré-populado mas editável pelo Financeiro depois.
model CategoriaDespesaPessoal {
  id           String   @id @default(cuid())
  nome         String   @unique
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  solicitacoes Solicitacao[]

  @@map("categorias_despesa_pessoal")
}

enum FormaPagamento {
  ADIANTAMENTO
  A_VISTA
  PARCELADO
}

// Como o pagamento em si vai ser feito (ticket 10, preenchido pelo
// comprador ao enviar para pagamento) — diferente de FormaPagamento, que são
// as condições comerciais (adiantamento/à vista/parcelado) escolhidas pelo
// solicitante na criação.
enum MetodoPagamento {
  PIX
  TED
  BOLETO
  CARTAO_CREDITO
  DINHEIRO
}

// Ticket 05: the state machine driving the whole approval/purchase/payment
// flow. See src/lib/workflow.ts — every transition is a function there, not
// a status update scattered across callers. Not every state is reachable
// yet (compra_confirmada onward are later tickets), but they're modeled now
// so the enum doesn't need a breaking change per ticket.
enum StatusSolicitacao {
  RASCUNHO
  ENVIADO
  AGUARDANDO_NIVEL2
  APROVADO
  REJEITADO
  COMPRA_CONFIRMADA
  AGUARDANDO_PAGAMENTO
  PAGAMENTO_RECUSADO
  PAGO
}

model Solicitacao {
  id             String            @id @default(cuid())
  solicitanteId  String
  solicitante    Usuario           @relation("SolicitacoesCriadas", fields: [solicitanteId], references: [id])
  departamentoId String
  departamento   Departamento      @relation(fields: [departamentoId], references: [id])
  tipoCompraId   String
  tipoCompra     TipoCompra        @relation(fields: [tipoCompraId], references: [id])
  descricao      String
  valor          Decimal           @db.Decimal(12, 2)
  status         StatusSolicitacao @default(RASCUNHO)

  // Encargos, taxas e outras despesas sem etapa de compra (ver DNI 0007:
  // ENCARGOS, ANVISA, MOTOBOY) — a documentação e os dados de pagamento já
  // vêm anexados na criação, e a aprovação final pula direto para
  // AGUARDANDO_PAGAMENTO em vez de passar por designação de comprador e
  // confirmação de compra (ver enviarDiretoParaPagamento em workflow.ts).
  semCompra Boolean @default(false)

  // Fields matching the company's existing purchase-request template. Todos
  // opcionais no schema (menos empresaId) porque uma solicitação de despesa
  // de pessoal (ver TipoCompra.despesaPessoal) não os usa, e uma de tipo com
  // TipoCompra.dispensaFornecedorForma não pede fornecedor/forma de
  // pagamento (o link da compra já traz essa informação) — a obrigatoriedade
  // de cada um por tipo de solicitação é decidida em validarCriarSolicitacao,
  // não aqui.
  fornecedor                String?
  formaPagamento            FormaPagamento?
  // onDelete: Restrict em todo FK opcional abaixo — sem isso, Prisma usa
  // SET NULL como padrão implícito pra relação opcional, o que faria
  // excluirCentroCusto/excluirCentroResultado/excluirContaContabil/
  // excluirCategoriaDespesaPessoal (lib/nome-simples.ts:
  // comMensagemDeUsoRestrito) silenciosamente apagar a classificação de
  // solicitações antigas em vez de bloquear a exclusão como sempre fizeram
  // (quando esses campos ainda eram obrigatórios, a própria constraint NOT
  // NULL impedia isso).
  centroCustoId             String?
  centroCusto               CentroCusto?     @relation(fields: [centroCustoId], references: [id], onDelete: Restrict)
  centroResultadoId         String?
  centroResultado           CentroResultado? @relation(fields: [centroResultadoId], references: [id], onDelete: Restrict)
  contaContabilId           String?
  contaContabil             ContaContabil?   @relation(fields: [contaContabilId], references: [id], onDelete: Restrict)
  empresaId                 String
  empresa                   Empresa          @relation(fields: [empresaId], references: [id])
  linkCompra                String?
  informacoesComplementares String?
  // Cotação/orçamento anexado pelo solicitante na criação, para apoiar a
  // decisão do aprovador — opcional, diferente de notaFiscalUrl (que só
  // existe depois da compra/pagamento).
  cotacaoUrl                String?

  // Despesa de pessoal (ver TipoCompra.despesaPessoal): categoria escolhida
  // pelo solicitante, nº do pedido opcional, e data de vencimento — nenhum
  // dos três existe fora desse tipo de solicitação.
  categoriaDespesaPessoalId String?
  categoriaDespesaPessoal   CategoriaDespesaPessoal? @relation(fields: [categoriaDespesaPessoalId], references: [id], onDelete: Restrict)
  numeroPedido              String?
  dataVencimento            DateTime?

  // RDV (ver TipoCompra.rdv): prestação de contas de reembolso já aprovada
  // pelo gestor em outro sistema. valor (campo já existente acima) é usado
  // como o valor a reembolsar; nenhum dos campos abaixo existe fora desse
  // tipo de solicitação.
  valorCartaoOnfly   Decimal? @db.Decimal(12, 2)
  dataRdv            DateTime?
  numeroRdv          String?
  possuiAdiantamento Boolean?

  // Populated by later tickets (comprador assignment, purchase, payment) —
  // nullable because they don't exist until the solicitação reaches that
  // point in the flow.
  compradorId             String?
  comprador               Usuario?         @relation("SolicitacoesCompradas", fields: [compradorId], references: [id])
  // Preenchida pelo comprador ao confirmar a compra, só quando
  // TipoCompra.exigePrevisaoChegada é true (ver confirmarCompra em
  // workflow.ts) — data estimada de chegada da mercadoria, comunicada ao
  // solicitante.
  previsaoChegada         DateTime?
  // Um ou mais caminhos no bucket de Storage (ver src/lib/storage.ts) — às
  // vezes há nota fiscal e boleto para enviar juntos, por exemplo.
  notaFiscalUrls          String[]         @default([])
  fornecedorDocumento     String?
  metodoPagamento         MetodoPagamento?
  dadosPagamento          String?
  comprovantePagamentoUrl String?
  motivoRejeicao          String?
  motivoRecusaPagamento   String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  historico SolicitacaoHistorico[]

  @@map("solicitacoes")
}

// Simple status trail (spec: "histórico simples de status, não um log de
// auditoria completo") — one row per transition, not a full audit log of
// every field change.
model SolicitacaoHistorico {
  id            String      @id @default(cuid())
  solicitacaoId String
  solicitacao   Solicitacao @relation(fields: [solicitacaoId], references: [id])
  evento        String
  atorId        String?
  ator          Usuario?    @relation(fields: [atorId], references: [id])
  detalhe       String?
  criadoEm      DateTime    @default(now())

  @@map("solicitacao_historico")
}
