generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Ticket 01: base user record, populated on Microsoft SSO login.
// departamentoId (nullable, FK) is added by ticket 02 once Departamento exists.
model Usuario {
  id              String   @id @default(cuid())
  nome            String
  email           String   @unique
  idEntra         String   @unique
  flagFinanceiro  Boolean  @default(false)
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  @@map("usuarios")
}
