generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Ticket 01: base user record, populated on Microsoft SSO login.
model Usuario {
  id             String   @id @default(cuid())
  nome           String
  email          String   @unique
  idEntra        String   @unique
  flagFinanceiro Boolean  @default(false)
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  // Ticket 02: which department this employee belongs to (nullable — not
  // every logged-in user has been assigned one yet).
  departamentoId String?
  departamento   Departamento? @relation("FuncionarioDepartamento", fields: [departamentoId], references: [id])

  // Inverse sides of Departamento.responsavel / Departamento.diretor — a
  // Usuario can be the level-1 or level-2 approver for several departments.
  departamentosResponsavel Departamento[] @relation("DepartamentoResponsavel")
  departamentosDiretor     Departamento[] @relation("DepartamentoDiretor")

  // Ticket 04: matrix entries where this Usuario is the designated comprador.
  matrizComprador MatrizComprador[]

  // Ticket 05: solicitações this Usuario created, vs. ones assigned to them
  // to buy (a later ticket) — distinct relations, same two models.
  solicitacoesCriadas   Solicitacao[]          @relation("SolicitacoesCriadas")
  solicitacoesCompradas Solicitacao[]          @relation("SolicitacoesCompradas")
  solicitacaoHistorico  SolicitacaoHistorico[]

  @@map("usuarios")
}

// Ticket 02: organizational structure the approval flow is built on.
// responsavelId (level-1 approver) and diretorId (level-2 approver) are
// required, not nullable — a department can't be created without both.
model Departamento {
  id            String   @id @default(cuid())
  nome          String   @unique
  responsavelId String
  responsavel   Usuario  @relation("DepartamentoResponsavel", fields: [responsavelId], references: [id])
  diretorId     String
  diretor       Usuario  @relation("DepartamentoDiretor", fields: [diretorId], references: [id])
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  funcionarios Usuario[] @relation("FuncionarioDepartamento")

  // Ticket 04: matrix entries scoped to this department.
  matrizComprador MatrizComprador[]

  // Ticket 05: solicitações made against this department.
  solicitacoes Solicitacao[]

  @@map("departamentos")
}

// Ticket 03: value bands that decide whether a solicitação needs only
// level-1 (responsável) approval or level-2 (diretor) as well. Company-wide,
// not per-department — no departamentoId here. exigeNivel2 is a boolean, not
// a level count, so the model can't express more than 2 approval levels.
model FaixaAlcada {
  id           String   @id @default(cuid())
  valorMin     Decimal  @db.Decimal(12, 2)
  valorMax     Decimal? @db.Decimal(12, 2)
  exigeNivel2  Boolean
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("faixas_alcada")
}

// Ticket 04: categorizes solicitações; seeded with 3 initial values but
// extensible via the admin screen without code changes.
model TipoCompra {
  id           String   @id @default(cuid())
  nome         String   @unique
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // Quando true, a designação de comprador (ver designarComprador em
  // workflow.ts) pula a matriz de comprador e a designação manual: o
  // comprador é sempre o próprio solicitante, já que é ele quem vai
  // executar a contratação (ex: serviços por departamento).
  compradorEhSolicitante Boolean @default(false)

  matrizComprador MatrizComprador[]

  // Ticket 05: solicitações of this tipo de compra.
  solicitacoes Solicitacao[]

  @@map("tipos_compra")
}

// Ticket 04: for a given (departamento, tipoCompra) pair, who buys it — the
// lookup a later ticket uses to auto-assign a comprador once a solicitação
// is approved. Not every combination needs an entry (unmatched ones fall
// back to Financeiro deciding manually), so the FK pair is unique but
// optional to populate.
model MatrizComprador {
  id             String       @id @default(cuid())
  departamentoId String
  departamento   Departamento @relation(fields: [departamentoId], references: [id])
  tipoCompraId   String
  tipoCompra     TipoCompra   @relation(fields: [tipoCompraId], references: [id])
  compradorId    String
  comprador      Usuario      @relation(fields: [compradorId], references: [id])
  criadoEm       DateTime     @default(now())
  atualizadoEm   DateTime     @updatedAt

  @@unique([departamentoId, tipoCompraId])
  @@map("matriz_comprador")
}

// Ticket 05: simple named lookups requested alongside the solicitação form
// (matching the company's existing purchase-request template) — each is
// just a name, cadastrado pelo Financeiro, same shape as TipoCompra.
model CentroCusto {
  id           String   @id @default(cuid())
  nome         String   @unique
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  solicitacoes Solicitacao[]

  @@map("centros_custo")
}

model CentroResultado {
  id           String   @id @default(cuid())
  nome         String   @unique
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  solicitacoes Solicitacao[]

  @@map("centros_resultado")
}

model ContaContabil {
  id           String   @id @default(cuid())
  nome         String   @unique
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  solicitacoes Solicitacao[]

  @@map("contas_contabeis")
}

model Empresa {
  id           String   @id @default(cuid())
  nome         String   @unique
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  solicitacoes Solicitacao[]

  @@map("empresas")
}

enum FormaPagamento {
  ADIANTAMENTO
  A_VISTA
  PARCELADO
}

// Como o pagamento em si vai ser feito (ticket 10, preenchido pelo
// comprador ao enviar para pagamento) — diferente de FormaPagamento, que são
// as condições comerciais (adiantamento/à vista/parcelado) escolhidas pelo
// solicitante na criação.
enum MetodoPagamento {
  PIX
  TED
  BOLETO
  CARTAO_CREDITO
  DINHEIRO
}

// Ticket 05: the state machine driving the whole approval/purchase/payment
// flow. See src/lib/workflow.ts — every transition is a function there, not
// a status update scattered across callers. Not every state is reachable
// yet (compra_confirmada onward are later tickets), but they're modeled now
// so the enum doesn't need a breaking change per ticket.
enum StatusSolicitacao {
  RASCUNHO
  ENVIADO
  AGUARDANDO_NIVEL2
  APROVADO
  REJEITADO
  COMPRA_CONFIRMADA
  AGUARDANDO_PAGAMENTO
  PAGAMENTO_RECUSADO
  PAGO
}

model Solicitacao {
  id             String            @id @default(cuid())
  solicitanteId  String
  solicitante    Usuario           @relation("SolicitacoesCriadas", fields: [solicitanteId], references: [id])
  departamentoId String
  departamento   Departamento      @relation(fields: [departamentoId], references: [id])
  tipoCompraId   String
  tipoCompra     TipoCompra        @relation(fields: [tipoCompraId], references: [id])
  descricao      String
  valor          Decimal           @db.Decimal(12, 2)
  status         StatusSolicitacao @default(RASCUNHO)

  // Encargos, taxas e outras despesas sem etapa de compra (ver DNI 0007:
  // ENCARGOS, ANVISA, MOTOBOY) — a documentação e os dados de pagamento já
  // vêm anexados na criação, e a aprovação final pula direto para
  // AGUARDANDO_PAGAMENTO em vez de passar por designação de comprador e
  // confirmação de compra (ver enviarDiretoParaPagamento em workflow.ts).
  semCompra Boolean @default(false)

  // Fields matching the company's existing purchase-request template.
  fornecedor                String
  formaPagamento            FormaPagamento
  centroCustoId             String
  centroCusto               CentroCusto     @relation(fields: [centroCustoId], references: [id])
  centroResultadoId         String
  centroResultado           CentroResultado @relation(fields: [centroResultadoId], references: [id])
  contaContabilId           String
  contaContabil             ContaContabil   @relation(fields: [contaContabilId], references: [id])
  empresaId                 String
  empresa                   Empresa         @relation(fields: [empresaId], references: [id])
  linkCompra                String?
  informacoesComplementares String?
  // Cotação/orçamento anexado pelo solicitante na criação, para apoiar a
  // decisão do aprovador — opcional, diferente de notaFiscalUrl (que só
  // existe depois da compra/pagamento).
  cotacaoUrl                String?

  // Populated by later tickets (comprador assignment, purchase, payment) —
  // nullable because they don't exist until the solicitação reaches that
  // point in the flow.
  compradorId             String?
  comprador               Usuario?         @relation("SolicitacoesCompradas", fields: [compradorId], references: [id])
  notaFiscalUrl           String?
  fornecedorDocumento     String?
  metodoPagamento         MetodoPagamento?
  dadosPagamento          String?
  comprovantePagamentoUrl String?
  motivoRejeicao          String?
  motivoRecusaPagamento   String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  historico SolicitacaoHistorico[]

  @@map("solicitacoes")
}

// Simple status trail (spec: "histórico simples de status, não um log de
// auditoria completo") — one row per transition, not a full audit log of
// every field change.
model SolicitacaoHistorico {
  id            String      @id @default(cuid())
  solicitacaoId String
  solicitacao   Solicitacao @relation(fields: [solicitacaoId], references: [id])
  evento        String
  atorId        String?
  ator          Usuario?    @relation(fields: [atorId], references: [id])
  detalhe       String?
  criadoEm      DateTime    @default(now())

  @@map("solicitacao_historico")
}
