# Banco de dados (Postgres via Supabase). DATABASE_URL usa o pooler em modo
# transação (porta 6543, pgbouncer=true) para o app em runtime; DIRECT_URL usa
# o pooler em modo sessão (porta 5432) para migrations, que precisam de
# prepared statements.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Banco de testes: mesmo projeto Supabase acima, isolado no schema "test" (não
# um projeto/banco separado) — a suíte roda contra Postgres real, nunca
# mockado. O `?schema=test` na URL é só documentação: quem de fato aponta o
# app para o schema "test" durante os testes é tests/setup.ts, que redireciona
# DATABASE_URL para este valor e define DATABASE_SCHEMA=test antes de
# qualquer teste rodar (o driver `pg` não entende `?schema=` na URL). O CLI
# do Prisma usa `?schema=test` de verdade, ao rodar `npm run db:migrate:test`
# (que usa DIRECT_URL_TEST).
DATABASE_URL_TEST="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=test"
DIRECT_URL_TEST="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=test"

# NextAuth (Auth.js)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Login Microsoft (Azure AD / Entra ID)
# Ver guia em SETUP.md (seção Azure AD) para como obter estes valores.
# TENANT_ID precisa ser o GUID do tenant (não "common"/"organizations") —
# o envio de e-mail via Graph (abaixo) reaproveita este valor e exige um
# tenant concreto, mesmo que o login em si aceitasse um alias multi-tenant.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=""

# E-mail transacional via Microsoft Graph, reaproveitando o mesmo app acima
# (precisa da permissão de aplicativo Mail.Send, com consentimento de admin).
# Deve ser uma caixa de e-mail real do tenant.
EMAIL_FROM="ti@seudominio.com.br"

# Supabase Storage (anexos: nota fiscal/comprovante de compra). Mesmo projeto
# do DATABASE_URL acima — SUPABASE_URL é só https://<project-ref>.supabase.co.
# SUPABASE_SERVICE_ROLE_KEY vem de Project Settings → API → "service_role"
# secret key. Usada só no servidor (Server Actions), nunca exposta ao
# navegador — dá acesso total ao projeto, então nunca deve virar
# NEXT_PUBLIC_*.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
